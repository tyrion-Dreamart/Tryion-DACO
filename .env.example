# Variables para docker-compose.yml (db, redis, api).
# Copia este archivo a .env y cambia TODOS los valores antes de "docker compose up".

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=daco
POSTGRES_PASSWORD=change_me
POSTGRES_DB=daco

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me

# ─── Security ─────────────────────────────────────────────────────────────────
# Generar con: openssl rand -hex 32
SECRET_KEY=change_me_use_256_bit_random_key

# ─── App ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
