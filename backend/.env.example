# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=daco
POSTGRES_PASSWORD=change_me
POSTGRES_DB=daco

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change_me_use_256_bit_random_key
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── App ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Email — alertas de vencimiento ──────────────────────────────────────────
# Si se deja cualquiera de estos vacío, el job de alertas sigue marcando
# facturas/cotizaciones normal, solo se salta el envío del correo.
ALERTAS_JOB_INTERVAL_HOURS=6
SMTP_HOST=smtp.dreamhost.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERTAS_EMAIL_TO=
